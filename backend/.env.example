APP_NAME=Kondai API
ENVIRONMENT=development
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173
AUTH_MODE=dev
DEV_USER_ID=local-founder
DEV_WORKSPACE_ID=local-workspace
STORE_MODE=json
JSON_STORE_PATH=data/store.json
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
AI_MODE=deterministic
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash
OUTBOUND_MODE=mock
SUPPORT_CONFIDENCE_THRESHOLD=0.72
MAX_DAILY_EXECUTIONS=50

# GitHub codebase integration
# Create a GitHub OAuth App and use this exact callback URL:
# http://localhost:8000/api/v1/integrations/github/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/integrations/github/oauth/callback
GITHUB_OAUTH_SCOPE=repo read:user
GITHUB_API_VERSION=2022-11-28

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=

GITHUB_SYNC_FILE_LIMIT=1000
GITHUB_SYNC_MANIFEST_LIMIT=24
GITHUB_SYNC_FILE_SIZE_LIMIT=100000



# Gmail support inbox OAuth
# Enable Gmail API in Google Cloud and create a Web application OAuth client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/integrations/gmail/oauth/callback
GMAIL_OAUTH_SCOPE=openid email https://www.googleapis.com/auth/gmail.readonly
GMAIL_DEFAULT_QUERY=in:inbox newer_than:30d -category:promotions -category:social
GMAIL_SYNC_LIMIT=100

# Live connector limits
FIRESTORE_SYNC_DOCUMENT_LIMIT=2500
STRIPE_SYNC_PAGE_LIMIT=5
POSTHOG_DEFAULT_HOST=https://us.posthog.com

# WhatsApp Business Platform Cloud API
# Credentials are entered from the Connections page and encrypted server-side.
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_CUSTOMER_WINDOW_HOURS=24
WHATSAPP_MESSAGE_BODY_LIMIT=4096

# Meta WhatsApp Embedded Signup v4
# These values belong to Kondai as the platform owner. Customers never enter them.
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_EMBEDDED_SIGNUP_REDIRECT_URI=
META_EMBEDDED_SIGNUP_FEATURE_TYPE=
META_WEBHOOK_VERIFY_TOKEN=
PUBLIC_API_BASE_URL=http://localhost:8000
META_AUTO_REGISTER_PHONE_NUMBER=true

# Configure this once in Meta App Dashboard → WhatsApp → Configuration:
# Callback URL: ${PUBLIC_API_BASE_URL}/api/v1/integrations/whatsapp/webhook
# Verify token: META_WEBHOOK_VERIFY_TOKEN

