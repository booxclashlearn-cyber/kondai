# KONDAI BACKEND
# Copy to backend/.env.local for localhost development.
# Add production values in Render -> Environment. Never commit real secrets.

APP_NAME=Kondai API
ENVIRONMENT=development
API_PREFIX=/api/v1

# Development defaults. In Render set FRONTEND_URL to the Vercel address below.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://kondai-flax.vercel.app
PUBLIC_API_BASE_URL=http://localhost:8000

AUTH_MODE=dev
DEV_USER_ID=local-founder
DEV_WORKSPACE_ID=local-workspace

STORE_MODE=json
JSON_STORE_PATH=data/store.json
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=

AI_MODE=deterministic
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

OUTBOUND_MODE=mock
SUPPORT_CONFIDENCE_THRESHOLD=0.72
MAX_DAILY_EXECUTIONS=50

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Leave blank to derive from PUBLIC_API_BASE_URL.
GITHUB_REDIRECT_URI=
GITHUB_OAUTH_SCOPE=repo read:user
GITHUB_API_VERSION=2022-11-28
GITHUB_SYNC_FILE_LIMIT=1000
GITHUB_SYNC_MANIFEST_LIMIT=24
GITHUB_SYNC_FILE_SIZE_LIMIT=100000

# Generate once using:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=

# Gmail OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Leave blank to derive from PUBLIC_API_BASE_URL.
GMAIL_REDIRECT_URI=
GMAIL_OAUTH_SCOPE=openid email https://www.googleapis.com/auth/gmail.readonly
GMAIL_DEFAULT_QUERY=in:inbox newer_than:30d -category:promotions -category:social
GMAIL_SYNC_LIMIT=100

FIRESTORE_SYNC_DOCUMENT_LIMIT=2500
STRIPE_SYNC_PAGE_LIMIT=5
POSTHOG_DEFAULT_HOST=https://us.posthog.com

WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_CUSTOMER_WINDOW_HOURS=24
WHATSAPP_MESSAGE_BODY_LIMIT=4096

META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_EMBEDDED_SIGNUP_REDIRECT_URI=
META_EMBEDDED_SIGNUP_FEATURE_TYPE=
META_WEBHOOK_VERIFY_TOKEN=
META_AUTO_REGISTER_PHONE_NUMBER=true

# RENDER URL VALUES
# ENVIRONMENT=production
# FRONTEND_URL=https://kondai-flax.vercel.app
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://kondai-flax.vercel.app
# PUBLIC_API_BASE_URL=https://kondai.onrender.com
